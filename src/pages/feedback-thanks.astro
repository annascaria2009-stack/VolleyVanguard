---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import site from '../data/site.json';
---

<BaseLayout
  title="Thank You"
  description="Thank you for sharing your feedback with VolleyVanguard."
>
  <section class="section">
    <div class="wrap">
      <div class="card">
        <SectionLabel text="Feedback Received" />
        <h1 class="title">Thank you!</h1>
        <p class="body">
          Thank you for your valuable feedback and support! Your input means the world to us,
          and we can't wait to see you back on the court.
        </p>
        <p class="body">
          If you have any further questions, feel free to contact us at
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        <a href="/" class="btn">Back to home →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .card {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(11, 31, 58, 0.07);
    padding: 44px 32px;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .title {
    font-size: 40px;
    color: var(--navy);
    margin-bottom: 16px;
  }
  .body {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .body a {
    color: var(--navy);
    font-weight: 600;
  }
  .card .btn {
    margin-top: 12px;
  }

  @media (max-width: 760px) {
    .title {
      font-size: 30px;
    }
    .card {
      padding: 32px 20px;
    }
  }
</style>
