---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProgramCard from '../components/ProgramCard.astro';
import { getCollection, render } from 'astro:content';

const programs = (await getCollection('programs')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  programs.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---
<BaseLayout title="Programs" description="VolleyVanguard coaching programs.">
  <section class="section">
    <div class="wrap">
      <SectionLabel text="What We Offer" />
      <h1 style="font-size:42px;color:var(--navy);margin-bottom:12px">Programs</h1>
      <p style="color:var(--muted);max-width:640px;margin-bottom:36px">
        From first touches to competitive play, we offer programs designed to
        meet every player where they are and help them grow.
      </p>

      {rendered.length === 0 ? (
        <div class="notice">
          <h2 class="notice-title">No camps running right now</h2>
          <p class="notice-body">
            Our Summer 2026 camp has wrapped up, and we don't have any sessions
            scheduled at the moment. New dates will be posted here as soon as
            they're set — in the meantime, <a href="/contact">get in touch</a> if
            you'd like us to let you know when registration opens.
          </p>
        </div>
      ) : (
        <div class="program-grid">
          {rendered.map(({ entry, Content }) => (
            <ProgramCard title={entry.data.title} image={entry.data.image} ctaUrl={entry.data.ctaUrl} ctaText={entry.data.ctaText}>
              <Content />
            </ProgramCard>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
<style>
  .program-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .notice {
    background: #fff;
    border-left: 4px solid var(--coral);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(11, 31, 58, 0.07);
    padding: 28px 30px;
    max-width: 680px;
  }

  .notice-title {
    font-size: 22px;
    color: var(--navy);
    margin-bottom: 10px;
  }

  .notice-body {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .notice-body a {
    color: var(--navy);
    font-weight: 600;
  }
</style>
