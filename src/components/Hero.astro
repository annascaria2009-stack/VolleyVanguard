---
interface Props {
  heading: string;
  subtext: string;
  image: string;
  ctaUrl?: string;
  ctaText?: string;
  /** Optional second button, rendered alongside the first. */
  cta2Url?: string;
  cta2Text?: string;
}

const {
  heading,
  subtext,
  image,
  ctaUrl = '/contact',
  ctaText = 'Get in touch →',
  cta2Url,
  cta2Text,
} = Astro.props;
---

<section class="hero">
  <div class="bg" style={`background-image:url(${image})`}></div>
  <div class="overlay"></div>
  <div class="wrap">
    <h1>{heading}</h1>
    <p>{subtext}</p>
    <div class="cta-row">
      <a href={ctaUrl} class="btn">{ctaText}</a>
      {cta2Url && cta2Text && (
        <a href={cta2Url} class="btn btn-ghost">{cta2Text}</a>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }

  .bg {
    background-size: cover;
    background-position: center;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(11,31,58,0.86), rgba(19,49,92,0.72));
    z-index: 1;
  }

  .wrap {
    position: relative;
    z-index: 2;
    padding: 80px 20px;
  }

  h1 {
    font-size: clamp(34px, 6vw, 64px);
    font-weight: 900;
    letter-spacing: -0.5px;
    line-height: 1.02;
  }

  p {
    max-width: 520px;
    margin-top: 18px;
    font-size: 18px;
    opacity: 0.9;
    line-height: 1.55;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  /* Secondary button: outlined, so the primary still leads */
  .btn-ghost {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.75);
    color: #fff;
    padding: 10px 22px;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: #fff;
    filter: none;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 460px;
    }

    .wrap {
      padding: 60px 20px;
    }
  }
</style>
